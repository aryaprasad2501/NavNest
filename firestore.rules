rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Security Helper functions
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isSpaceMember(spaceData) {
      return isAuthenticated() && request.auth.uid in spaceData.memberIds;
    }

    // 1. User Profiles (Personal profile information)
    match /user_profiles/{userId} {
      // Owner can read and write their own profile
      allow read, write: if isOwner(userId);
      // Authenticated students can read public partner display name/photo
      allow read: if isAuthenticated();
    }

    // 2. Private User Study Backups (Completed sessions, Mature Trees, Planner)
    match /users/{userId}/study_sessions/{sessionId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/forest_trees/{treeId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/planner_tasks/{taskId} {
      allow read, write: if isOwner(userId);
    }

    // 3. Shared Space Pairing Invitations
    match /shared_space_invites/{inviteCode} {
      // Authenticated users can read active invites to join, or creators can read their own
      allow read: if isAuthenticated() && (
        resource.data.status == 'ACTIVE' ||
        resource.data.creatorUid == request.auth.uid ||
        resource.data.claimedByUid == request.auth.uid
      );

      // Creator can create an invite with valid expiration
      allow create: if isAuthenticated() &&
        request.resource.data.creatorUid == request.auth.uid &&
        request.resource.data.status == 'ACTIVE' &&
        request.resource.data.expiresAt > request.time;

      // Only claiming user or creator can update invite status
      allow update: if isAuthenticated() && (
        // Claiming: transition ACTIVE -> ACCEPTED
        (resource.data.status == 'ACTIVE' &&
         request.resource.data.status == 'ACCEPTED' &&
         request.resource.data.claimedByUid == request.auth.uid) ||
        // Revoking by creator
        (resource.data.creatorUid == request.auth.uid &&
         request.resource.data.status == 'REVOKED')
      );

      // No client deletion of pairing logs
      allow delete: if false;
    }

    // 4. Private 2-Person Shared Spaces
    match /shared_spaces/{spaceId} {
      // Read: strictly authenticated space members
      allow read: if isSpaceMember(resource.data);

      // Create: user must be the creator, must include themselves in memberIds, max 2 members
      allow create: if isAuthenticated() &&
        request.resource.data.createdByUserId == request.auth.uid &&
        request.auth.uid in request.resource.data.memberIds &&
        request.resource.data.memberIds.size() <= 2;

      // Update: members only, member count can never exceed 2
      allow update: if isAuthenticated() &&
        (isSpaceMember(resource.data) ||
         (resource.data.memberIds.size() < 2 &&
          request.resource.data.memberIds.size() <= 2 &&
          request.auth.uid in request.resource.data.memberIds));

      // Delete: only if user is the creator or member
      allow delete: if isAuthenticated() && isSpaceMember(resource.data);

      // Encouragement Cheers subcollection
      match /cheers/{cheerId} {
        allow read: if isAuthenticated() && isSpaceMember(get(/databases/$(database)/documents/shared_spaces/$(spaceId)).data);
        allow create: if isAuthenticated() &&
          isSpaceMember(get(/databases/$(database)/documents/shared_spaces/$(spaceId)).data) &&
          request.resource.data.senderUid == request.auth.uid;
        allow update, delete: if false;
      }

      // Member Status subcollection (Real-time accountability without chat rabbit holes)
      match /member_status/{memberUid} {
        allow read: if isAuthenticated() && isSpaceMember(get(/databases/$(database)/documents/shared_spaces/$(spaceId)).data);
        allow write: if isOwner(memberUid) && isSpaceMember(get(/databases/$(database)/documents/shared_spaces/$(spaceId)).data);
      }
    }
  }
}
